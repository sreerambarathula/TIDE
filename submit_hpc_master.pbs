#!/bin/bash
#PBS -N TIDE_MASTER
#PBS -P as_mae_jyho
#PBS -j oe
#PBS -M barathula.sreeram@ntu.edu.sg
#PBS -m ae
#PBS -l walltime=02:00:00
#PBS -l select=1:ncpus=24:mpiprocs=24:mem=48gb
#PBS -o TIDE_MASTER_RUN.log

set -Eeuo pipefail
cd "$PBS_O_WORKDIR"

echo "================================================================================"
echo " TIDE ALL-IN-ONE MASTER HPC EXECUTION"
echo " Start Time: $(date)"
echo " Host: $(hostname)"
echo " Workdir: $PBS_O_WORKDIR"
echo " Cores Allocated: 24"
echo "================================================================================"


# 1. Environment Bootstrap
echo "[STEP 1/3] Loading Python module & configuring clean virtual environment..."
module load python/3.11 2>/dev/null || module load python3 2>/dev/null || module load anaconda3 2>/dev/null || true

if [ ! -d ".hpc_venv" ]; then
    echo "  Creating fresh virtual environment (.hpc_venv)..."
    python3 -m venv .hpc_venv
fi

source .hpc_venv/bin/activate
echo "  Python executable: $(which python3)"
echo "  Python version:    $(python3 --version)"

echo "  Installing/verifying locked dependencies..."
python3 -m pip install --upgrade pip setuptools wheel --quiet
if [ -f "requirements-lock.txt" ]; then
    python3 -m pip install -r requirements-lock.txt --quiet || python3 -m pip install jax jaxlib numpy scipy matplotlib pymupdf pytest --quiet
else
    python3 -m pip install jax jaxlib numpy scipy matplotlib pymupdf pytest --quiet
fi
python3 -m pip install -e . --no-deps --quiet 2>/dev/null || true

# 2. Execute Master Pipeline
echo "[STEP 2/3] Launching End-to-End Master Pipeline (All 7 Stages across 24 Cores)..."
export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1

python3 -u run_master_pipeline.py --mode full --cores 24 2>&1 | tee -a TIDE_MASTER_RUN.log

# 3. Final Summary & Completion Checkpoint
echo "================================================================================"
echo "[STEP 3/3] Execution Complete!"
echo " End Time: $(date)"
echo " Check DATA_DIFF_REPORT.md for the fresh vs reference data comparison."
echo " Check manuscript/figures/ for the newly rendered 300 DPI figures."
echo "================================================================================"
